{
  "expo": {
    "name": "SmartTag",
    "slug": "smart-tag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smarttag",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.matheus.smarttag",
      "associatedDomains": [
        "applinks:smarttag-front.vercel.app"
      ]
    },
    "android": {
      "package": "com.matheus.smarttag",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "smarttag-front.vercel.app",
              "pathPrefix": "/alerta"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permita que o SmartTag acesse sua localização para marcar onde você estacionou o seu veículo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o SmartTag acesse sua câmera para ler o QR Code dos veículos."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/icon.png",
          "imageWidth": 140
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "301c8f87-f2df-48ab-ac99-bf1ed7082c72"
      }
    }
  }
}
